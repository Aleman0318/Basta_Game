<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_fondocuaderno">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="50dp">

        <ImageView
            android:id="@+id/imgLogoBasta"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_basta" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3">

            <TextView
                android:id="@+id/txtCodigoSala"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:gravity="center"
                android:drawableStart="@drawable/outline_person_24"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_chip_blanco_azul"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Sala TEST1"
                android:textColor="#064DDB"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtRondaActual"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:drawableStart="@android:drawable/ic_popup_sync"
                android:drawableTint="#064DDB"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_chip_blanco_gris"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Ronda 1/5"
                android:textColor="#064DDB"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtEstadoPartida"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_chip__blanco_verde"
                android:fontFamily="@font/lilitaone_regular"
                android:text="● En juego"
                android:textColor="#3A8C24"
                android:textSize="14sp" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardJugadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1.5dp"
            app:strokeColor="#D6E0FF">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJugadoresPartida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:clipToPadding="false" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/contenedorLetra"
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/imgMarcoLetra"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:src="@drawable/marco_rojo" />

                <ImageView
                    android:id="@+id/imgLetraActual"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/letra_m" />

            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="140dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/cardTiempo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_blanco_azul">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="Tiempo restante"
                        android:textColor="#064DDB"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txtTiempoRestante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/summer"
                        android:text="00:37"
                        android:textColor="#E91D2C"
                        android:textSize="40sp" />

                    <TextView
                        android:id="@+id/txtInstruccionLetra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Respuestas con la letra M"
                        android:textColor="#064DDB"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|end"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#064DDB" />
            </FrameLayout>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRespuestas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1.5dp"
            app:strokeColor="#D6E0FF">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategoriasJuego"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:padding="8dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:scrollbarSize="4dp" />

        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBasta"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_boton_basta"
            android:fontFamily="@font/lilitaone_regular"
            android:text="¡BASTA!"
            android:textAllCaps="false"
            android:textColor="@color/blanco"
            android:textSize="32sp"
            android:elevation="6dp" />

    </LinearLayout>

</ScrollView>