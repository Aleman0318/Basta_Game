<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fondocuaderno">

    <ScrollView
        android:id="@+id/scrollPartida"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:isScrollContainer="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="170dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgLogoBasta"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_basta" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="3">

                <TextView
                    android:id="@+id/txtCodigoSala"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:drawableStart="@drawable/ic_calendario"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_chip_blanco_azul"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="Sala TEST1"
                    android:drawableTint="@color/colorPrimary"
                    android:textColor="#064DDB"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtRondaActual"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:drawableStart="@drawable/ic_rueda"
                    android:drawableTint="@color/colorPrimary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_chip_blanco_gris"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="Ronda 1/5"
                    android:textColor="#064DDB"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtEstadoPartida"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_chip__blanco_verde"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="● En espera"
                    android:textColor="#3A8C24"
                    android:textSize="14sp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardJugadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="6dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/colorPrimary">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvJugadoresPartida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:clipToPadding="false" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/contenedorLetra"
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:id="@+id/imgMarcoLetra"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/marco_rojo" />

                    <ImageView
                        android:id="@+id/imgLetraActual"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/letra_m"
                        android:rotation="-9" />

                </FrameLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="140dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/cardTiempo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_chip_blanco_azul">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="Tiempo restante"
                            android:textColor="#064DDB"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/txtTiempoRestante"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/summer"
                            android:text="--:--"
                            android:textColor="#E91D2C"
                            android:textSize="40sp" />

                        <View
                            android:layout_width="110dp"
                            android:layout_height="1dp"
                            android:background="@color/colorBasta" />

                        <TextView
                            android:id="@+id/txtInstruccionLetra"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:fontFamily="@font/manrope_regular"
                            android:text="Respuestas con la letra M"
                            android:textColor="#064DDB"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_marginTop="-5dp"
                        android:layout_marginEnd="6dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/ic_crono" />

                </FrameLayout>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRespuestas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="26dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardElevation="8dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/colorPrimary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:gravity="center"
                            android:background="@drawable/bg_chip_blanco_azul"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="✎"
                            android:textColor="@color/colorPrimary"
                            android:textSize="26sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lilitaone_regular"
                                android:text="Hoja de respuestas"
                                android:textColor="@color/colorTextoP"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/manrope_regular"
                                android:text="Escribe una palabra por categoría"
                                android:textColor="@color/colorContenidoInputs"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnComodines"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:padding="0dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text=""
                            android:textAllCaps="false"
                            app:backgroundTint="@color/colorPrimary"
                            app:cornerRadius="16dp"
                            app:elevation="3dp"
                            app:icon="@drawable/ic_comodines"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="45dp"
                            app:iconTint="@null" />


                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="8dp"
                        android:background="#D6E0FF" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCategoriasJuego"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="230dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="6dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:descendantFocusability="afterDescendants"
                        android:scrollbars="none" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBasta"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_boton_basta"
                android:fontFamily="@font/lilitaone_regular"
                android:text="¡BASTA!"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="32sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalida"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_boton_exit"
                app:backgroundTint="@null"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Salir"
                android:textAllCaps="false"
                android:textColor="@color/blanco"
                android:textSize="36sp"
                app:icon="@drawable/salida"
                app:iconSize="46dp"
                app:iconGravity="textEnd"
                app:iconTint="@color/blanco" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/notificationPartida"
        layout="@layout/component_notification_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.80"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>