<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_fondocuaderno">
  <LinearLayout android:id="@+id/scrollPartida" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="4dp" android:paddingBottom="4dp">
      <LinearLayout android:id="@+id/chromePartida" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
          <ImageView android:id="@+id/imgLogoBasta" android:layout_width="match_parent" android:layout_height="@dimen/logo_partida_alto" android:adjustViewBounds="true" android:scaleType="fitCenter" android:src="@drawable/logo_basta" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center" android:weightSum="3">
          <androidx.appcompat.widget.AppCompatTextView android:id="@+id/txtCodigoSala" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:gravity="center" android:drawableStart="@drawable/ic_calendario" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/bg_chip_blanco_azul" android:fontFamily="@font/lilitaone_regular" android:text="Sala TEST1" android:drawableTint="@color/colorPrimary" android:textColor="#064DDB" android:textSize="14sp" android:paddingTop="0dp" android:paddingBottom="0dp" android:maxLines="2" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="10sp" app:autoSizeMaxTextSize="14sp" app:autoSizeStepGranularity="1sp" />
          <androidx.appcompat.widget.AppCompatTextView android:id="@+id/txtRondaActual" android:layout_width="0dp" android:layout_height="35dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:gravity="center" android:drawableStart="@drawable/ic_rueda" android:drawableTint="@color/colorPrimary" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/bg_chip_blanco_gris" android:fontFamily="@font/lilitaone_regular" android:text="Ronda 1/5" android:textColor="#064DDB" android:textSize="14sp" android:paddingTop="0dp" android:paddingBottom="0dp" android:maxLines="2" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="10sp" app:autoSizeMaxTextSize="14sp" app:autoSizeStepGranularity="1sp" />
          <androidx.appcompat.widget.AppCompatTextView android:id="@+id/txtEstadoPartida" android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/bg_chip__blanco_verde" android:fontFamily="@font/lilitaone_regular" android:text="● En espera" android:textColor="#3A8C24" android:textSize="14sp" android:paddingStart="4dp" android:paddingEnd="4dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:maxLines="2" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="10sp" app:autoSizeMaxTextSize="14sp" app:autoSizeStepGranularity="1sp" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardJugadores" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="6dp" app:strokeWidth="1dp" app:strokeColor="@color/colorPrimary">
          <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvJugadoresPartida" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="2dp" android:clipToPadding="false" />
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
        <FrameLayout android:id="@+id/contenedorLetra" android:layout_width="0dp" android:layout_height="@dimen/reloj_partida_alto" android:layout_weight="1" android:layout_marginEnd="10dp">
          <ImageView android:id="@+id/imgMarcoLetra" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:src="@drawable/marco_rojo" />
          <ImageView android:id="@+id/imgLetraActual" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="10dp" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/letra_m" android:rotation="-9" />
          <TextView android:id="@+id/txtLetraSinRecurso" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:fontFamily="@font/lilitaone_regular" android:textSize="72sp" android:textColor="#064DDB" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="@dimen/reloj_partida_alto" android:layout_weight="1">
          <LinearLayout android:id="@+id/cardTiempo" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="2dp" android:layout_marginEnd="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_chip_blanco_azul">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/lilitaone_regular" android:text="Tiempo" android:textColor="#064DDB" android:textSize="14sp" />
            <androidx.appcompat.widget.AppCompatTextView android:id="@+id/txtTiempoRestante" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_marginTop="2dp" android:fontFamily="@font/summer" android:text="--:--" android:textColor="#E91D2C" android:textSize="34sp" android:layout_weight="1" android:gravity="center" android:maxLines="1" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="18sp" app:autoSizeMaxTextSize="34sp" app:autoSizeStepGranularity="1sp" />
            <View android:layout_width="110dp" android:layout_height="1dp" android:background="@color/colorBasta" />
            <TextView android:id="@+id/txtInstruccionLetra" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/manrope_regular" android:text="Empieza con M" android:textColor="#064DDB" android:textSize="11sp" android:textStyle="bold" />
          </LinearLayout>
          <ImageView android:layout_width="36dp" android:layout_height="36dp" android:layout_marginTop="-2dp" android:layout_marginEnd="6dp" android:layout_gravity="top|end" android:src="@drawable/ic_crono" />
        </FrameLayout>
      </LinearLayout>
      <com.google.android.material.card.MaterialCardView android:id="@+id/cardRespuestas" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#FFFFFF" app:cardElevation="8dp" app:strokeWidth="2dp" app:strokeColor="@color/colorPrimary" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="4dp" android:paddingBottom="6dp" android:paddingStart="4dp" android:paddingEnd="4dp">
            <TextView android:layout_width="46dp" android:layout_height="46dp" android:visibility="gone" android:gravity="center" android:background="@drawable/bg_chip_blanco_azul" android:fontFamily="@font/lilitaone_regular" android:text="✎" android:textColor="@color/colorPrimary" android:textSize="26sp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/lilitaone_regular" android:text="Hoja de respuestas" android:textColor="@color/colorTextoP" android:textSize="18sp" />
              <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/manrope_regular" android:text="Escribe tus palabras" android:textColor="@color/colorContenidoInputs" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnComodines" android:layout_width="112dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Comodines" android:textSize="12sp" android:textColor="@color/blanco" android:fontFamily="@font/lilitaone_regular" android:contentDescription="Usar comodines" android:textAllCaps="false" app:backgroundTint="@color/colorPrimary" app:strokeColor="@color/colorPrimary" app:strokeWidth="1dp" app:cornerRadius="16dp" app:elevation="1dp" app:icon="@drawable/ic_comodines" app:iconGravity="textStart" app:iconPadding="4dp" app:iconSize="20dp" app:iconTint="@null" />
          </LinearLayout>
          <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginBottom="8dp" android:background="#D6E0FF" />
          <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCategoriasJuego" android:layout_width="match_parent" android:layout_height="0dp" android:paddingTop="4dp" android:paddingBottom="6dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" android:overScrollMode="never" android:descendantFocusability="afterDescendants" android:scrollbars="none" android:layout_weight="1" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBasta" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_boton_basta" android:fontFamily="@font/lilitaone_regular" android:text="¡BASTA!" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="26sp" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSalida" android:layout_width="0dp" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_boton_exit" app:backgroundTint="@null" android:fontFamily="@font/lilitaone_regular" android:text="Salir" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="26sp" app:icon="@drawable/salida" app:iconSize="28dp" app:iconGravity="textEnd" app:iconTint="@color/blanco" android:layout_weight="1" android:layout_marginHorizontal="4dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <include android:id="@+id/notificationPartida" layout="@layout/component_notification_card" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintWidth_percent="0.80" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>