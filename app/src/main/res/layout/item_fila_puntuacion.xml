<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FCFDFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeColor="#D6E0FF"
    app:strokeWidth="1.2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtPosicion"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_chip_blanco_azul"
                android:fontFamily="@font/lilitaone_regular"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                tools:text="1°" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombreJugadorTabla"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/lilitaone_regular"
                    android:maxLines="1"
                    android:textColor="@color/colorTextoP"
                    android:textSize="18sp"
                    tools:text="Alemango2382" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_regular"
                    android:text="Puntaje acumulado por ronda"
                    android:textColor="@color/colorContenidoInputs"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/cajaPuntajeTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:background="@drawable/bg_total_puntos_tabla"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_regular"
                        android:text="TOTAL"
                        android:textColor="@color/verde_puntos"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtTotalPuntos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lilitaone_regular"
                        android:textColor="@color/verde_puntos"
                        android:textSize="21sp"
                        android:includeFontPadding="false"
                        tools:text="20" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtAnimacionCambio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/lilitaone_regular"
                    android:textColor="#FF9800"
                    android:textSize="24sp"
                    android:visibility="gone"
                    android:elevation="10dp"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    tools:text="🔄" />
            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorPuntosRondas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>