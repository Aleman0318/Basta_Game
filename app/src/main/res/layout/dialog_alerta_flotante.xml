<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="#FCFDFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="20dp"
    app:strokeColor="#FFCDD2"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_comodin_agotado"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lilitaone_regular"
            android:text="¡COMODÍN AGOTADO!"
            android:textColor="#E53935"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/txtMensajeAlertaFlotante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/manrope_regular"
            android:gravity="center"
            android:textColor="#5E6C84"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Ya usaste este comodín en esta ronda. ¡Espera a la siguiente!" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntendidoAlerta"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/lilitaone_regular"
            android:text="ENTENDIDO"
            android:textColor="@color/blanco"
            android:textSize="16sp"
            app:backgroundTint="#E53935"
            app:cornerRadius="12dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>