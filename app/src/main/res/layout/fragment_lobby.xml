<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorTransparente">

    <include
        android:id="@+id/notificationLobby"
        layout="@layout/component_notification_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.82"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerLobby"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="7dp"
            android:src="@drawable/btn_atras1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTituloLobby"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="58dp"
            android:paddingEnd="58dp"
            android:fontFamily="@font/lilitaone_regular"
            android:gravity="center"
            android:text="LOBBY DE ESPERA"
            android:textColor="@color/colorPrimary"
            android:textSize="29sp"
            android:letterSpacing="0.03"
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="@id/btnRegresar"
            app:layout_constraintBottom_toBottomOf="@id/btnRegresar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/lineaTituloLobby"
            android:layout_width="170dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="@color/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/tvTituloLobby"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:id="@+id/scrollLobby"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerLobby"
        app:layout_constraintBottom_toTopOf="@id/bottomBarLobby"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <!-- ID SALA -->
            <TextView
                android:id="@+id/tvLabelSala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lilitaone_regular"
                android:gravity="center"
                android:text="ID de Sala"
                android:textColor="@color/colorTextoP"
                android:textSize="20sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCodigoSala"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginStart="42dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="42dp"
                app:cardBackgroundColor="@color/colorBg"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/colorSecondary"
                app:strokeWidth="2dp">

                <TextView
                    android:id="@+id/tvidSalaLobby"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/lilitaone_regular"
                    android:gravity="center"
                    android:text="AB1234"
                    android:textColor="@color/colorSecondary"
                    android:textSize="31sp"
                    android:letterSpacing="0.06" />

            </com.google.android.material.card.MaterialCardView>

            <!-- REGLAS -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReglasLobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/colorBg"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeColor="#B8C8FF"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/tvTituloReglasLobby"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lilitaone_regular"
                        android:gravity="center"
                        android:text="Reglas de la partida"
                        android:textColor="@color/colorTextoP"
                        android:textSize="22sp" />

                    <View
                        android:layout_width="150dp"
                        android:layout_height="2dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/colorPrimary" />

                    <!-- CATEGORÍAS -->
                    <LinearLayout
                        android:id="@+id/layoutReglaCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="•"
                            android:textColor="@color/colorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvLabelCategoriasLobby"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/miracledays"
                            android:text="Categorías: "
                            android:textColor="@color/colorTextoP"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvValorCategoriasLobby"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/playkidz"
                            android:text="Nombre, Color, País, Apellido"
                            android:textColor="@color/colorPrimary"
                            android:textSize="18sp"
                            android:lineSpacingExtra="3dp"
                            tools:text="Nombre, Color, Fruta, País, Animal, Cosa, Apellido" />

                    </LinearLayout>

                    <!-- RONDAS -->
                    <LinearLayout
                        android:id="@+id/layoutReglaRondas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="•"
                            android:textColor="#4CAF50"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvLabelRondasLobby"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/miracledays"
                            android:text="Rondas: "
                            android:textColor="@color/colorTextoP"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvValorRondasLobby"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/playkidz"
                            android:text="1"
                            android:textColor="@color/colorPrimary"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <!-- DURACIÓN -->
                    <LinearLayout
                        android:id="@+id/layoutReglaDuracion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="•"
                            android:textColor="#E91D63"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvLabelDuracionLobby"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/miracledays"
                            android:text="Duración: "
                            android:textColor="@color/colorTextoP"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvValorDuracionLobby"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/playkidz"
                            android:text="2:00 min por ronda"
                            android:textColor="@color/colorPrimary"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <!-- JUGADORES -->
                    <LinearLayout
                        android:id="@+id/layoutReglaJugadores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="18dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="•"
                            android:textColor="#673AB7"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvLabelJugadoresLobby"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/miracledays"
                            android:text="Jugadores: "
                            android:textColor="@color/colorTextoP"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvValorJugadoresLobby"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/playkidz"
                            android:text="Máximo 4"
                            android:textColor="@color/colorPrimary"
                            android:textSize="18sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- JUGADORES CONECTADOS -->
            <TextView
                android:id="@+id/tvTituloJugadoresConectados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Jugadores conectados"
                android:textColor="@color/colorTextoP"
                android:textSize="22sp" />

            <View
                android:layout_width="190dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:background="@color/colorPrimary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJugadoresLobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:listitem="@layout/item_jugador" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTONES INFERIORES -->
    <LinearLayout
        android:id="@+id/bottomBarLobby"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnToggleListo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_boton_pildora"
            android:backgroundTint="#4CAF50"
            android:elevation="5dp"
            android:fontFamily="@font/lilitaone_regular"
            android:text="ESTOY LISTO"
            android:textAllCaps="false"
            android:textColor="@color/colorBg"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnComenzarPartida"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_boton_pildora"
            android:backgroundTint="@color/colorPrimary"
            android:elevation="5dp"
            android:fontFamily="@font/lilitaone_regular"
            android:text="¡COMENZAR!"
            android:textAllCaps="false"
            android:textColor="@color/colorBg"
            android:textSize="21sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>