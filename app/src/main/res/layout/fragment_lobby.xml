<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fondocuaderno">

    <include
        android:id="@+id/notificationLobby"
        layout="@layout/component_notification_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.82"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/headerLobby"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="start|center_vertical"
            android:padding="8dp"
            android:src="@drawable/btn_atras1"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:id="@+id/contenedorTituloLobby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTituloLobby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lilitaone_regular"
                android:gravity="center"
                android:text="Lobby de espera"
                android:textColor="@color/colorPrimary"
                android:textSize="31sp"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:fontFamily="@font/manrope_regular"
                android:text="Reúne a tus amigos antes de empezar"
                android:textColor="@color/colorTextoP"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

        </LinearLayout>

    </FrameLayout>

    <ScrollView
        android:id="@+id/scrollLobby"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerLobby"
        app:layout_constraintBottom_toTopOf="@id/bottomBarLobby"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="8dp"
            android:paddingBottom="18dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCodigoSala"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/blanco"
                app:cardCornerRadius="28dp"
                app:cardElevation="9dp"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="20dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#EEF4FF"
                        app:strokeWidth="1.5dp"
                        app:strokeColor="@color/colorPrimary">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="ID"
                            android:textColor="@color/colorPrimary"
                            android:textSize="24sp" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvLabelSala"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/lilitaone_regular"
                        android:gravity="center"
                        android:text="Código de invitación"
                        android:textColor="@color/colorTextoP"
                        android:textSize="23sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Compártelo para que se unan a la sala"
                        android:textColor="@color/colorContenidoInputs"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvidSalaLobby"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginHorizontal="24dp"
                        android:background="@drawable/bg_chip_blanco_azul"
                        android:fontFamily="@font/lilitaone_regular"
                        android:gravity="center"
                        android:text="AB1234"
                        android:textColor="@color/colorPrimary"
                        android:textSize="33sp"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Esperando jugadores..."
                        android:textColor="@color/colorTextoP"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReglasLobby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/blanco"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:strokeColor="#D6E0FF"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EEF4FF"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="@color/colorPrimary">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:fontFamily="@font/lilitaone_regular"
                                android:text="i"
                                android:textColor="@color/colorPrimary"
                                android:textSize="30sp" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTituloReglasLobby"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lilitaone_regular"
                                android:text="Reglas de la partida"
                                android:textColor="@color/colorTextoP"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_regular"
                                android:text="Configuración elegida por el anfitrión"
                                android:textColor="@color/colorContenidoInputs"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="#D6E0FF" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FCFDFF"
                        app:strokeColor="#BFD0FF"
                        app:strokeWidth="1.5dp">

                        <LinearLayout
                            android:id="@+id/layoutReglaCategorias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="#EEF4FF"
                                    app:strokeColor="@color/colorPrimary"
                                    app:strokeWidth="1.5dp">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:fontFamily="@font/lilitaone_regular"
                                        android:text="ABC"
                                        android:textColor="@color/colorPrimary"
                                        android:textSize="13sp" />

                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="11dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvLabelCategoriasLobby"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/lilitaone_regular"
                                        android:text="Categorías elegidas"
                                        android:textColor="@color/colorTextoP"
                                        android:textSize="20sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/manrope_regular"
                                        android:text="Estas serán las columnas de la ronda"
                                        android:textColor="@color/colorContenidoInputs"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvValorCategoriasLobby"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:text="Nombre, Color, País, Apellido" />

                            <LinearLayout
                                android:id="@+id/contenedorCategoriasLobby"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EEF4FF"
                            app:strokeColor="#BFD0FF"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:id="@+id/layoutReglaRondas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    android:id="@+id/tvValorRondasLobby"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/lilitaone_regular"
                                    android:text="1"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="22sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/tvLabelRondasLobby"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/manrope_regular"
                                    android:text="Rondas"
                                    android:textColor="@color/colorTextoP"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:gravity="center" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="6dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FCFDFF"
                            app:strokeColor="#D6E0FF"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:id="@+id/layoutReglaDuracion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    android:id="@+id/tvValorDuracionLobby"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/lilitaone_regular"
                                    android:text="2:20"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="22sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/tvLabelDuracionLobby"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/manrope_regular"
                                    android:text="Tiempo"
                                    android:textColor="@color/colorTextoP"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:gravity="center" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EEF4FF"
                            app:strokeColor="#BFD0FF"
                            app:strokeWidth="1.5dp">

                            <LinearLayout
                                android:id="@+id/layoutReglaJugadores"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="6dp">

                                <TextView
                                    android:id="@+id/tvValorJugadoresLobby"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/lilitaone_regular"
                                    android:text="4"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="22sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <TextView
                                    android:id="@+id/tvLabelJugadoresLobby"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/manrope_regular"
                                    android:text="Jug. máx."
                                    android:textColor="@color/colorTextoP"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:gravity="center" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/blanco"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:strokeColor="#D6E0FF"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#EEF4FF"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="@color/colorPrimary">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_siluetas" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTituloJugadoresConectados"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/lilitaone_regular"
                                android:text="Jugadores conectados"
                                android:textColor="@color/colorTextoP"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/manrope_regular"
                                android:text="Cuando todos estén listos, empieza el juego"
                                android:textColor="@color/colorContenidoInputs"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="#D6E0FF" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvJugadoresLobby"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="86dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:clipToPadding="false"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        tools:listitem="@layout/item_jugador" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBarLobby"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp"
        android:background="@color/colorTransparente"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnToggleListo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_boton_pildora"
            android:backgroundTint="#4CAF50"
            android:elevation="5dp"
            android:fontFamily="@font/lilitaone_regular"
            android:text="ESTOY LISTO"
            android:textAllCaps="false"
            android:textColor="@color/colorBg"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnComenzarPartida"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_boton_pildora"
            android:backgroundTint="@color/colorPrimary"
            android:elevation="5dp"
            android:fontFamily="@font/lilitaone_regular"
            android:text="¡COMENZAR!"
            android:textAllCaps="false"
            android:textColor="@color/colorBg"
            android:textSize="21sp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>