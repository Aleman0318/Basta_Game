<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/crema"
    app:strokeWidth="2dp"
    app:strokeColor="#000000"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/txtSalaHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Sala: ABCD"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textAlignment="center" />

            <View
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/txtTiempoHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Tiempo: 6:33"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textAlignment="center" />

            <View
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:background="#000000" />

            <TextView
                android:id="@+id/txtRondasHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Rondas: 5"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textAlignment="center" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#000000" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="16dp"
                android:paddingHorizontal="4dp"
                android:gravity="top"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:text="👑"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        app:cardCornerRadius="27.5dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="#8BC34A"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/imgJugador1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/outline_person_24"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/txtNombreJugador1"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginVertical="6dp"
                        android:gravity="center"
                        android:fontFamily="@font/manrope_regular"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Jugador 1" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#AEEA00"
                        app:strokeWidth="2dp"
                        app:strokeColor="#000000"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/txtPuntosJugador1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="740"
                            android:textColor="#000000"
                            android:textAlignment="center"
                            android:paddingVertical="4dp"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_regular"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="2°"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        app:cardCornerRadius="27.5dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="#FFEB3B"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/imgJugador2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/outline_person_24"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/txtNombreJugador2"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginVertical="6dp"
                        android:gravity="center"
                        android:fontFamily="@font/manrope_regular"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Jugador 2" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#FFD600"
                        app:strokeWidth="2dp"
                        app:strokeColor="#000000"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/txtPuntosJugador2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="541"
                            android:textColor="#000000"
                            android:textAlignment="center"
                            android:paddingVertical="4dp"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_regular"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="2°"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        app:cardCornerRadius="27.5dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="#FFEB3B"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/imgJugador6"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/outline_person_24"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/txtNombreJugador6"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginVertical="6dp"
                        android:gravity="center"
                        android:fontFamily="@font/manrope_regular"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Jugador 2" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#FFD600"
                        app:strokeWidth="2dp"
                        app:strokeColor="#000000"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/txtPuntosJugador6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="541"
                            android:textColor="#000000"
                            android:textAlignment="center"
                            android:paddingVertical="4dp"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_regular"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="3°"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        app:cardCornerRadius="27.5dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="#FF9800"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/imgJugador3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/outline_person_24"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/txtNombreJugador3"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginVertical="6dp"
                        android:gravity="center"
                        android:fontFamily="@font/manrope_regular"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Jugador 3" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#FF6D00"
                        app:strokeWidth="2dp"
                        app:strokeColor="#000000"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/txtPuntosJugador3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="333"
                            android:textColor="#000000"
                            android:textAlignment="center"
                            android:paddingVertical="4dp"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_regular"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="4°"
                        android:textColor="#000000"
                        android:textSize="22sp"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        app:cardCornerRadius="27.5dp"
                        app:strokeWidth="3dp"
                        app:strokeColor="#B71C1C"
                        app:cardElevation="0dp">
                        <ImageView
                            android:id="@+id/imgJugador4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/outline_person_24"
                            android:scaleType="centerCrop"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/txtNombreJugador4"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginVertical="6dp"
                        android:gravity="center"
                        android:fontFamily="@font/manrope_regular"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end"
                        tools:text="Jugador 4" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#D32F2F"
                        app:strokeWidth="2dp"
                        app:strokeColor="#000000"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/txtPuntosJugador4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="111"
                            android:textColor="#000000"
                            android:textAlignment="center"
                            android:paddingVertical="4dp"
                            android:textSize="14sp"
                            android:fontFamily="@font/manrope_regular"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>