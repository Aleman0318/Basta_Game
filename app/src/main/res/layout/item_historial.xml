<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="@color/blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/colorPrimary"
            android:paddingVertical="14dp"
            android:paddingHorizontal="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/txtSalaHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Sala: ABCD"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textAlignment="viewStart" />

            <TextView
                android:id="@+id/txtTiempoHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Tiempo: 6:33"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/txtRondasHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Rondas: 5"
                android:textColor="@color/blanco"
                android:textSize="16sp"
                android:textAlignment="viewEnd" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvJugadoresPartidaHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:paddingVertical="16dp"
            android:paddingHorizontal="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>