<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:background="@drawable/bg_fondocuaderno3">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/blanco"
        app:cardCornerRadius="24dp"
        app:cardElevation="7dp"
        app:strokeColor="@color/colorPrimary"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/txtTituloResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lilitaone_regular"
                android:gravity="center"
                android:text="PUNTUACIONES"
                android:textColor="@color/colorPrimary"
                android:textSize="26sp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="PUNTUACIONES - RONDA 2" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/manrope_regular"
                android:gravity="center"
                android:text="Resultados de la ronda y total acumulado"
                android:textColor="@color/colorContenidoInputs"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#FCFDFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeColor="#D6E0FF"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="13dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_total_puntos_tabla"
                android:fontFamily="@font/lilitaone_regular"
                android:gravity="center"
                android:text="1°"
                android:textColor="@color/colorSecondary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="Mejor jugador"
                    android:textColor="@color/colorTextoP"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/txtGanadorResultados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_regular"
                    android:text="Calculando resultados..."
                    android:textColor="@color/colorContenidoInputs"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/blanco"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="#D6E0FF"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="Ranking"
                    android:textColor="@color/blanco"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_chip_blanco_azul"
                    android:fontFamily="@font/manrope_regular"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="PUNTOS"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contenedorEncabezadosRondas"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:orientation="horizontal" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTablaPuntuaciones"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                tools:listitem="@layout/item_fila_puntuacion" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtPendientesRevision"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_blanco_azul"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        android:fontFamily="@font/manrope_regular"
        android:text="Comprobando quién falta..."
        android:textColor="@color/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUsarComodinFinal"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FF9800"
        android:fontFamily="@font/lilitaone_regular"
        android:text="USAR COMODÍN"
        android:textColor="@color/blanco"
        android:textSize="18sp"
        app:cornerRadius="18dp"
        app:strokeColor="#E65100"
        app:strokeWidth="2dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverInicio"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/colorPrimary"
        android:fontFamily="@font/lilitaone_regular"
        android:text="LISTO"
        android:textColor="@color/blanco"
        android:textSize="18sp"
        app:cornerRadius="18dp" />

</LinearLayout>