<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp" android:background="@color/colorTransparente">
    <TextView android:id="@+id/txtRelojGeneralRevision" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="56dp" android:padding="8dp"
        android:gravity="center" android:fontFamily="@font/lilitaone_regular" android:textSize="32sp"
        android:text="Preparando..." android:textColor="@color/colorPrimary" android:background="@drawable/bg_chip_blanco_azul" />
<androidx.viewpager2.widget.ViewPager2 android:id="@+id/vpCategoriasValidacion"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSalirRevision"
        android:layout_width="match_parent" android:layout_height="55dp" android:layout_margin="8dp"
        android:background="@drawable/bg_boton_basta" android:fontFamily="@font/lilitaone_regular"
        android:text="Salir de revision" android:textColor="@android:color/white" android:textSize="20sp" android:visibility="gone" />
</LinearLayout>