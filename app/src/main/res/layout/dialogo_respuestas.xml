<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorTransparente">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpCategoriasValidacion"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSalirRevision"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="35dp"
        android:layout_marginBottom="35dp"
        android:background="@drawable/bg_boton_basta"
        android:fontFamily="@font/lilitaone_regular"
        android:text="Salir de revisión"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:visibility="gone" />

</RelativeLayout>
