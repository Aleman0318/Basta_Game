<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#D6E0FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="9dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EEF4FF"
            app:strokeWidth="1dp"
            app:strokeColor="#BFD0FF">

            <ImageView
                android:id="@+id/imgIconoCategoriaPartida"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/outline_person_24" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtNombreCategoriaPartida"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/comic"
            android:text="Animal"
            android:textColor="@color/colorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <EditText
            android:id="@+id/etRespuestaCategoriaPartida"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_input_juego"
            android:paddingHorizontal="12dp"
            android:fontFamily="@font/manrope_regular"
            android:textSize="15sp"
            android:gravity="center"
            android:hint="Respuesta..."
            android:textColorHint="@color/colorContenidoInputs"
            android:textColor="@color/colorPrimary"
            android:maxLines="1"
            android:singleLine="true" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>