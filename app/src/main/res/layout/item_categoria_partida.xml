<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/imgIconoCategoriaPartida"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/outline_person_24" />

    <TextView
        android:id="@+id/txtNombreCategoriaPartida"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/comic"
        android:textColor="#064DDB"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Animal" />

    <EditText
        android:id="@+id/etRespuestaCategoriaPartida"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="40dp"
        android:background="@drawable/bg_input_juego"
        android:paddingHorizontal="12dp"
        android:fontFamily="@font/manrope_regular"
        android:textSize="15sp"
        android:hint="Escribe tu respuesta..."
        android:textColorHint="#999999"
        android:textColor="#064DDB"
        android:maxLines="1"
        android:singleLine="true" />

</LinearLayout>