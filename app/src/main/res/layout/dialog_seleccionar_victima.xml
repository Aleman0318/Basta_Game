<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/blanco"
    app:cardCornerRadius="28dp"
    app:strokeColor="#D6E0FF"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lilitaone_regular"
            android:text="¡MARCA DE LA MUERTE!"
            android:textColor="#E65100"
            android:textSize="24sp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope_regular"
            android:text="Elige a quién arrastrarás al duelo:"
            android:textColor="#5E6C84"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVictimas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarVictima"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/lilitaone_regular"
            android:text="CANCELAR"
            android:textColor="#5E6C84"
            android:textSize="16sp"
            app:backgroundTint="#EEF4FF"
            app:cornerRadius="14dp"
            app:elevation="0dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>