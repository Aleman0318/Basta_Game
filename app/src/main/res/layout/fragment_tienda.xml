<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainTienda"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:background="@drawable/bg_fondocuaderno3"
    android:paddingTop="16dp"
    tools:context=".Fragments.TiendaFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardHeaderTienda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTiendaDe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TIENDA DE"
            android:fontFamily="@font/lilitaone_regular"
            android:textColor="#14213D"
            android:textSize="24sp"
            android:rotation="-4"
            android:padding="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtComodines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COMODINES"
            android:fontFamily="@font/lilitaone_regular"
            android:textColor="#0B4CE3"
            android:textSize="40sp"
            android:rotation="-4"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtTiendaDe"
            app:layout_constraintStart_toStartOf="@id/txtTiendaDe"
            android:layout_marginTop="-16dp"
            android:layout_marginStart="2dp"/>

        <TextView
            android:id="@+id/txtSubtituloTienda"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cartas y ventajas para destruir amistades."
            android:fontFamily="@font/manrope_regular"
            android:textColor="#666666"
            android:textSize="12sp"
            android:textStyle="bold"
            android:rotation="-3"
            app:layout_constraintTop_toBottomOf="@id/txtComodines"
            app:layout_constraintStart_toStartOf="@id/txtComodines"
            android:layout_marginTop="-4dp"
            android:layout_marginStart="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMonedas"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            app:cardBackgroundColor="#F8F9FA"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="#2B2B2B"
            app:strokeWidth="2.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_monedas" />

                <TextView
                    android:id="@+id/txtMonedasTienda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/summer"
                    android:textColor="#E8730C"
                    android:textSize="20sp"
                    tools:text="2996650" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGemas"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#F8F9FA"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="#2B2B2B"
            app:strokeWidth="2.5dp"
            app:layout_constraintEnd_toEndOf="@id/cardMonedas"
            app:layout_constraintTop_toBottomOf="@id/cardMonedas">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_gemas" />

                <TextView
                    android:id="@+id/txtGemasTienda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="@font/lilitaone_regular"
                    android:textColor="#2B2B2B"
                    android:textSize="20sp"
                    tools:text="0" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#2B2B2B"
                    app:strokeWidth="1.5dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:textColor="#2B2B2B"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvComodinesTienda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingBottom="28dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardHeaderTienda"
        tools:listitem="@layout/item_comodin_tienda" />

    <include
        android:id="@+id/notificationTienda"
        layout="@layout/component_notification_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="40dp"
        android:translationZ="40dp"
        app:layout_constraintWidth_percent="0.88"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>