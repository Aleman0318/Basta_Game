<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fondocuaderno"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="44dp"
        android:paddingBottom="34dp">

        <!-- Logo ¡BASTA! + listón -->
        <ImageView
            android:id="@+id/ivLogoBasta"
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_basta" />

        <!-- Libreta central -->
        <ImageView
            android:id="@+id/ivImagenCentral"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="-8dp"
            android:layout_marginStart="26dp"
            android:layout_marginEnd="26dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/cuaderno" />

        <!-- Tarjeta de login -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="@color/colorBg"
            app:cardCornerRadius="26dp"
            app:cardElevation="10dp"
            app:strokeWidth="1dp"
            app:strokeColor="#22000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="26dp"
                android:paddingEnd="24dp"
                android:paddingBottom="22dp">

                <!-- Usuario -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/cajaUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/outline_person_24"
                    app:startIconTint="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_input_pildora"
                        android:fontFamily="@font/manrope_regular"
                        android:hint="Usuario"
                        android:inputType="textPersonName"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/colorTextoP"
                        android:textColorHint="@color/colorTextoP"
                        android:textSize="17sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Contraseña -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/cajaPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="26dp"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/colorPrimary"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    app:startIconTint="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_input_pildora"
                        android:fontFamily="@font/manrope_regular"
                        android:hint="Contraseña"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/colorTextoP"
                        android:textColorHint="@color/colorTextoP"
                        android:textSize="17sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Botón comenzar -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEntrar"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_boton_pildora"
                    android:fontFamily="@font/lilitaone_regular"
                    android:letterSpacing="0.12"
                    android:text="COMENZAR"
                    android:textAllCaps="false"
                    android:textColor="@color/colorBg"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Registro -->
                <TextView
                    android:id="@+id/tvIrRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/playkidz"
                    android:gravity="center"
                    android:text="¿No tienes cuenta? Regístrate aquí"
                    android:textColor="@color/colorPrimary"
                    android:textSize="17sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>