<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorTransparente">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerUnirse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnRegresar"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/btn_atras1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lilitaone_regular"
            android:text="Unirse a la sala"
            android:textColor="@color/colorNaranjaBrillante"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerUnirse"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.2">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorBg"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/colorNaranjaBrillante"
            app:strokeWidth="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="36dp"
            android:paddingHorizontal="20dp"
            android:background="@color/colorSecondaryTenue"
            android:gravity="center">

            <ImageView
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_unirse_sala_naranja"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Código de Invitación"
                android:textColor="@color/colorTextoP"
                android:textSize="27sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="28dp"
                android:fontFamily="@font/manrope_regular"
                android:gravity="center"
                android:text="Pídele el ID al anfitrión de la partida\npara poder ingresar."
                android:textColor="@color/colorTextoP"
                android:textStyle="bold"
                android:textSize="18sp"

                android:lineSpacingExtra="4dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                app:cardBackgroundColor="@color/colorGrisAzulado"
                app:cardCornerRadius="16dp"
                app:strokeColor="@color/colorNaranjaBrillante"
                app:strokeWidth="3dp">

                <EditText
                    android:id="@+id/etSalaId"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@color/colorGrisAzulado"
                    android:fontFamily="@font/lilitaone_regular"
                    android:gravity="center"
                    android:hint="EJ: AB1234"
                    android:textColorHint="@color/colorNaranjaBrillante"
                    android:textColor="@color/colorSecondary"
                    android:textSize="30sp"
                    android:textAllCaps="true"
                    android:maxLength="6"
                    android:maxLines="1"
                    android:inputType="textCapCharacters" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUnirseSalaFinal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_boton_pildora"
            android:fontFamily="@font/lilitaone_regular"
            android:text="Entrar a sala"
            android:textColor="@color/colorBg"
            android:textSize="24sp"
            android:letterSpacing="0.10"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>