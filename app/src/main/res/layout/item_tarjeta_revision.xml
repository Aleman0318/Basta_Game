<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="6dp"
    android:paddingVertical="12dp">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="false" android:scrollbars="vertical">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:cardCornerRadius="28dp"
        app:cardBackgroundColor="@color/blanco"
        app:cardElevation="10dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="18dp"
            android:paddingBottom="22dp"
            android:paddingHorizontal="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EEF4FF"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/colorPrimary">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="ABC"
                    android:textColor="@color/colorPrimary"
                    android:textSize="18sp" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/lilitaone_regular"
                android:text="Revisión de categoría"
                android:textColor="@color/colorTextoP"
                android:textSize="27sp" />

            <TextView
                android:id="@+id/txtNombreCategoriaTarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_chip_blanco_azul"
                android:fontFamily="@font/lilitaone_regular"
                android:paddingHorizontal="20dp"
                android:paddingVertical="5dp"
                android:text="Fruta"
                android:textColor="@color/colorPrimary"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/manrope_regular"
                android:text="Todos revisan la misma categoría al mismo tiempo"
                android:textColor="@color/colorContenidoInputs"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#FFF7D6"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/amarillochillon"
                app:strokeWidth="1.2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp">

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_blanco_gris"
                        android:fontFamily="@font/lilitaone_regular"
                        android:gravity="center"
                        android:text="!"
                        android:textColor="@color/colorSecondary"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/txtIndicacionVotacionCategoria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Si se vota una palabra, esa palabra queda marcada y ya no se puede volver a votar."
                        android:textColor="@color/colorTextoP"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="#D6E0FF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRespuestasTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />
            <TextView
                android:id="@+id/txtDeslizarTarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_chip_blanco_gris"
                android:fontFamily="@font/manrope_regular"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Revisando juntos..."
                android:textColor="@color/colorTextoP"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    </ScrollView>
</FrameLayout>
