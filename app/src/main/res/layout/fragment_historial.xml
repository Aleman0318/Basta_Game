<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:paddingHorizontal="14dp"
    android:paddingTop="22dp"
    tools:context=".Fragments.HistorialFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeaderHistorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFF9E8"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="#20294A"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp">

            <TextView
                android:id="@+id/txtTituloHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lilitaone_regular"
                android:shadowColor="#FFFFFF"
                android:shadowDx="2"
                android:shadowDy="3"
                android:shadowRadius="1"
                android:text="HISTORIAL"
                android:textColor="@color/colorTextoP"
                android:textSize="38sp"
                app:layout_constraintEnd_toStartOf="@id/cardMonedasHistorial"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtSubtituloHistorial"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="Tus últimas 5 partidas"
                android:textColor="#6B607F"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/cardMonedasHistorial"
                app:layout_constraintStart_toStartOf="@id/txtTituloHistorial"
                app:layout_constraintTop_toBottomOf="@id/txtTituloHistorial" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMonedasHistorial"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                app:cardBackgroundColor="#FFF0A3"
                app:cardCornerRadius="19dp"
                app:cardElevation="5dp"
                app:strokeColor="#D99A00"
                app:strokeWidth="2dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="🪙"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/txtMonedasHistorial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:fontFamily="@font/lilitaone_regular"
                        android:textColor="#8E5C00"
                        android:textSize="24sp"
                        tools:text="350" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInfoHistorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#EAF0FF"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:strokeColor="#B8C7FF"
        app:strokeWidth="1.4dp"
        app:layout_constraintTop_toBottomOf="@id/cardHeaderHistorial"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_regular"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Revisa tus resultados, tu puesto y el podio de cada partida."
            android:textColor="#3D4770"
            android:textSize="12sp"
            android:textStyle="bold" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtEmptyHistorial"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lilitaone_regular"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="Todavía no tienes partidas guardadas\n¡Juega una ronda y vuelve aquí!"
        android:textColor="@color/colorContenidoInputs"
        android:textSize="23sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardInfoHistorial"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistorialPartidas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="2dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardInfoHistorial"
        tools:listitem="@layout/item_historial_partida" />

</androidx.constraintlayout.widget.ConstraintLayout>