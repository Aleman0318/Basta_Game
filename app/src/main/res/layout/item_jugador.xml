<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardJugadorLobby"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:layout_marginBottom="7dp"
    app:cardBackgroundColor="#FCFDFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="4dp"
    app:strokeColor="#D6E0FF"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/ivAvatarJugador"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/outline_person_24" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEstadoJugador"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="3dp"
                android:layout_marginBottom="3dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardCornerRadius="9dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/blanco"
                app:strokeWidth="2dp" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreJugador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/lilitaone_regular"
                android:maxLines="1"
                android:text="Nombre Jugador"
                android:textColor="@color/colorTextoP"
                android:textSize="18sp"
                tools:text="Alemango2382" />

            <TextView
                android:id="@+id/tvSubtituloJugador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_regular"
                android:maxLines="1"
                android:text="Jugador en sala"
                android:textColor="@color/colorContenidoInputs"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstadoPill"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            app:cardBackgroundColor="#EEF4FF"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:strokeColor="#BFD0FF"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="13dp">

                <TextView
                    android:id="@+id/tvIconoEstadoJugador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="●"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEstadoJugador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_regular"
                    android:text="Esperando"
                    android:textColor="@color/colorPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Esperando" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>