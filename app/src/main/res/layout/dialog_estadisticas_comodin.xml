<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeColor="#D6E0FF"
    app:strokeWidth="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- CABECERA DE COLOR -->
        <View
            android:id="@+id/headerFondoModal"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#EEF4FF"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnCerrarModal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_btn_equis"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/imgIconoModal"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_marginTop="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/ic_comodin_cambiodeflujo" />

        <TextView
            android:id="@+id/txtNombreModal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:fontFamily="@font/lilitaone_regular"
            android:textColor="#14213D"
            android:textSize="26sp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/imgIconoModal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Cambio de Flujo" />

        <TextView
            android:id="@+id/txtDescModal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="24dp"
            android:fontFamily="@font/manrope_regular"
            android:textColor="#5E6C84"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/txtNombreModal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Descripción más detallada del comodín." />

        <View
            android:id="@+id/dividerModal"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:background="#D6E0FF"
            app:layout_constraintTop_toBottomOf="@id/txtDescModal" />

        <!-- EL SCROLL CON EL CONTENEDOR DE REGLAS -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:overScrollMode="never"
            app:layout_constrainedHeight="true"
            app:layout_constraintHeight_max="250dp"
            app:layout_constraintTop_toBottomOf="@id/dividerModal"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/contenedorReglasModal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">
                <!-- Las reglas se inyectarán aquí desde Java automáticamente -->
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>