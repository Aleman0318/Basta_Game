<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tarjetaJugadorEsqueleto"
    android:layout_width="105dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/colorCajaTexto"
    app:strokeWidth="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/tarjetaJugadorIcono"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_corona_host"
                android:scaleType="fitCenter"
                android:visibility="gone"
                tools:visibility="visible"/>

            <TextView
                android:id="@+id/txtPosiciontarjetaJugador"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/lilitaone_regular"
                android:textColor="@color/colorTextoP"
                android:textSize="18sp"
                android:gravity="center"
                android:text="2°"
                android:visibility="visible"
                tools:visibility="gone"/>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatarBorde"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp">
            <ImageView
                android:id="@+id/tarjetaJugadorAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/outline_person_24"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtNombretarjetaJugador"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:fontFamily="@font/manrope_regular"
            android:textColor="@color/colorTextoP"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:text="Jugador X" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaJugadorPuntos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            app:cardBackgroundColor="@color/colorTextoP"
            app:cardCornerRadius="8dp">
            <TextView
                android:id="@+id/txtPuntostarjetaJugador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="740"
                android:textColor="@color/blanco"
                android:textStyle="bold"
                android:textAlignment="center"
                android:paddingVertical="6dp"
                android:textSize="16sp"
                android:fontFamily="@font/manrope_regular"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>