<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorTransparente">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <ImageView
                    android:id="@+id/btnRegresar"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:padding="8dp"
                    android:src="@drawable/btn_atras1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="CONFIGURAR SALA"
                    android:textColor="@color/colorPrimary"
                    android:textSize="30sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="ID de Sala: "
                    android:textColor="@color/colorTextoP"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvIdSala"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lilitaone_regular"
                    android:text="------"
                    android:textColor="@color/colorSecondary"
                    android:textSize="20sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/colorBg"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/colorGrisAzulado"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="Categorías del juego"
                        android:textColor="@color/colorTextoP"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Selecciona lo que habrá que escribir"
                        android:textColor="@color/colorTextoP"
                        android:alpha="0.7"
                        android:textSize="13sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCategorias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginVertical="20dp"
                        android:background="@color/colorGrisAzulado" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="Tiempo por ronda:"
                            android:textColor="@color/colorTextoP"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tvTiempoActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/lilitaone_regular"
                            android:text="30s"
                            android:textColor="@color/colorSecondary"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbTiempo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="60"
                        android:progress="30" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginVertical="20dp"
                        android:background="@color/colorGrisAzulado" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="Máximo de jugadores"
                        android:textColor="@color/colorTextoP"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Mínimo 2 usuarios / Máximo 8 usuarios"
                        android:textColor="@color/colorTextoP"
                        android:alpha="0.6"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnRestarJugador"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:background="@drawable/bg_fondo_icono_crearsala"
                            android:text="-"
                            android:textColor="@color/colorSecondary"
                            android:textStyle="bold"
                            android:textSize="30sp" />

                        <TextView
                            android:id="@+id/tvCantJugadores"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lilitaone_regular"
                            android:gravity="center"
                            android:text="4"
                            android:textColor="@color/colorSecondary"
                            android:textSize="24sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSumarJugador"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:rotationY="180"
                            android:background="@drawable/bg_fondo_icono_crearsala"
                            android:text="+"
                            android:textStyle="bold"
                            android:textColor="@color/colorSecondary"
                            android:textSize="25sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCrearSalaFinal"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_boton_pildora"
                android:fontFamily="@font/lilitaone_regular"
                android:text="CREAR"
                android:textColor="@color/colorBg"
                android:textSize="20sp" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>