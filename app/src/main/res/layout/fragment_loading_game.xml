<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_fondocuaderno3" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BF7CA1CF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieLoading"
            android:layout_width="220dp"
            android:layout_height="220dp"
            app:lottie_rawRes="@raw/loadingmano"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"/>

        <TextView
            android:id="@+id/tvLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/lilitaone_regular"
            android:text="¡Iniciando partida!"
            android:textColor="@color/colorTextoP"
            android:textSize="28sp"
            android:letterSpacing="0.02"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvSubLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:fontFamily="@font/manrope_regular"
            android:text="Prepara tus habilidades y sé veloz para ser el primero en presionar 'BASTA'..."
            android:textColor="@color/design_default_color_primary_dark"
            android:textSize="17sp"
            android:gravity="center"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

</FrameLayout>