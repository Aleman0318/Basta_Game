<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardComodinTiendaItem"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeColor="#8E24AA"
    app:strokeWidth="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imgEtiquetaTactiva"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:scaleType="fitStart"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@drawable/bg_tag_global" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconoComodinItem"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/imgEtiquetaTactiva"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/imgIconoComodinItem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_comodin_dobleonada" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtNombreComodinItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/lilitaone_regular"
            android:textColor="#14213D"
            android:textSize="18sp"
            android:lines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/cardIconoComodinItem"
            app:layout_constraintStart_toEndOf="@id/cardIconoComodinItem"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Doble o Nada" />

        <TextView
            android:id="@+id/txtDescripcionComodinItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/manrope_regular"
            android:textColor="#5E6C84"
            android:textSize="11sp"
            android:lines="3"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/txtNombreComodinItem"
            app:layout_constraintStart_toStartOf="@id/txtNombreComodinItem"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Apuesta tu conocimiento. Duplica tus puntos... o pierde todo." />

        <LinearLayout
            android:id="@+id/btnDesplegarReglas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toBottomOf="@id/txtDescripcionComodinItem"
            app:layout_constraintStart_toStartOf="@id/txtNombreComodinItem">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_regular"
                android:text="Ver estadísticas"
                android:textColor="#0B4CE3"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="▼"
                android:textColor="#0B4CE3"
                android:textSize="9sp"/>
        </LinearLayout>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="btnDesplegarReglas,cardIconoComodinItem" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutCompra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toBottomOf="@id/barrierBottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnComprarComodinItem"
                android:layout_marginEnd="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardInventarioItem"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingHorizontal="6dp">

                        <ImageView
                            android:id="@+id/imgIconoInventario"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_monedas" />

                        <TextView
                            android:id="@+id/txtCantidadInventarioItem"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/manrope_regular"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            tools:text="TIENES: 0" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/layoutPrecio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgTipoMonedaComodinItem"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_monedas" />

                    <TextView
                        android:id="@+id/txtPrecioComodinItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/summer"
                        android:textColor="#8E5C00"
                        android:textSize="24sp"
                        tools:text="450" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnComprarComodinItem"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                app:cardBackgroundColor="#00B300"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#007A00"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/summer"
                        android:text="COMPRAR"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_carrito_compras"
                        app:tint="#FFFFFF" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>