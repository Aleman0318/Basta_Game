<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="92dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="6dp">

    <!-- Medallita / posición -->
    <TextView
        android:id="@+id/txtPosicionJugador"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:background="@drawable/bg_medalla_puntaje"
        android:fontFamily="@font/lilitaone_regular"
        android:text="1"
        android:textColor="#064DDB"
        android:textSize="15sp"
        tools:text="1" />

    <!-- Avatar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="#064DDB"
        app:cardBackgroundColor="#EAF2FF">

        <ImageView
            android:id="@+id/imgAvatarPuntaje"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="3dp"
            android:scaleType="centerCrop"
            android:src="@drawable/perfil_menuu" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Nombre -->
    <TextView
        android:id="@+id/txtNombrePuntaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center"
        android:fontFamily="@font/lilitaone_regular"
        android:text="Marlon"
        android:textColor="#17213A"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Marlon" />

    <!-- Puntaje -->
    <TextView
        android:id="@+id/txtPuntosJugador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:fontFamily="@font/lilitaone_regular"
        android:text="35 ⭐"
        android:textColor="#064DDB"
        android:textSize="16sp"
        tools:text="35 ⭐" />

</LinearLayout>