<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="98dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FCFDFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="#D6E0FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:paddingHorizontal="5dp">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                app:cardCornerRadius="29dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/colorPrimary">

                <ImageView
                    android:id="@+id/imgAvatarJugadorPartida"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/outline_person_24" />

            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/imgCoronaHost"
                android:layout_width="38dp"
                android:layout_height="36dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-1dp"
                android:layout_marginTop="-4dp"
                android:rotation="-18"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_corona_host"
                android:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imgJugadorListoCheck"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="3dp"
                android:layout_marginEnd="3dp"
                android:visibility="visible"
                app:cardCornerRadius="11dp"
                app:cardBackgroundColor="@color/check"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="@color/blanco">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="✔"
                    android:textColor="@color/blanco"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:includeFontPadding="false" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <TextView
            android:id="@+id/txtNombreJugador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:fontFamily="@font/lilitaone_regular"
            android:textColor="@color/colorTextoP"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Marlon" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            app:cardCornerRadius="13dp"
            app:cardBackgroundColor="#EEF4FF"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/colorPrimary">

            <TextView
                android:id="@+id/txtEstadoJugador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:fontFamily="@font/manrope_regular"
                android:textColor="@color/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Escribiendo..." />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>