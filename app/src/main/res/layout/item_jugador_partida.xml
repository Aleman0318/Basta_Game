<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="85dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="55dp"
        android:layout_height="55dp"
        app:cardCornerRadius="27dp"
        app:cardElevation="0dp"
        app:strokeWidth="2dp"
        app:strokeColor="#D6E0FF">

        <ImageView
            android:id="@+id/imgAvatarJugadorPartida"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/outline_person_24" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtNombreJugador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:fontFamily="@font/lilitaone_regular"
        android:textColor="#17213A"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Marlon" />

    <TextView
        android:id="@+id/txtEstadoJugador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:background="@drawable/bg_chip_blanco_azul"
        android:fontFamily="@font/manrope_regular"
        android:textColor="#064DDB"
        android:textSize="10sp"
        android:textStyle="bold"
        tools:text="Escribiendo..." />

</LinearLayout>