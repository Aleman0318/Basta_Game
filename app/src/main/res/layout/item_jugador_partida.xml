<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="95dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E8E8E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:paddingHorizontal="4dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imgAvatarJugadorPartida"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/outline_person_24" />
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/imgCoronaHost"
                android:layout_width="37dp"
                android:layout_height="35dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="-2dp"
                android:layout_marginTop="-4dp"
                android:rotation="-18"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_corona_host"
                android:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/imgJugadorListoCheck"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="2dp"
                android:layout_marginEnd="2dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="#22C55E"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#FFFFFF"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="✔"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:includeFontPadding="false" />
            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <TextView
            android:id="@+id/txtNombreJugador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:fontFamily="@font/lilitaone_regular"
            android:textColor="#17213A"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Marlon" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="0dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#064DDB">

            <TextView
                android:id="@+id/txtEstadoJugador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:fontFamily="@font/manrope_regular"
                android:textColor="#064DDB"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Escribiendo..." />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>