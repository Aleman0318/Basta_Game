<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="102dp" android:layout_height="wrap_content" android:layout_marginHorizontal="4dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp"
 app:cardBackgroundColor="#FCFDFF" app:cardCornerRadius="16dp" app:cardElevation="3dp" app:strokeWidth="1dp" app:strokeColor="#D6E0FF" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp">
  <FrameLayout android:layout_width="44dp" android:layout_height="36dp">
   <com.google.android.material.card.MaterialCardView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/colorPrimary">
    <ImageView android:id="@+id/imgAvatarJugadorPartida" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/outline_person_24" />
   </com.google.android.material.card.MaterialCardView>
   <ImageView android:id="@+id/imgCoronaHost" android:layout_width="16dp" android:layout_height="14dp" android:layout_gravity="top|end" android:rotation="0" android:scaleType="fitCenter" android:src="@drawable/ic_corona_host" />
   <com.google.android.material.card.MaterialCardView android:id="@+id/imgJugadorListoCheck" android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="bottom|end" app:cardCornerRadius="8dp" app:cardBackgroundColor="@color/check" app:cardElevation="0dp">
    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="✔" android:textColor="@color/blanco" android:textSize="10sp" android:gravity="center" android:includeFontPadding="false" />
   </com.google.android.material.card.MaterialCardView>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"  android:orientation="vertical" android:layout_marginTop="2dp">
   <TextView android:id="@+id/txtNombreJugador" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/lilitaone_regular" android:textColor="@color/colorTextoP" android:textSize="13sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
   <TextView android:id="@+id/txtEstadoJugador" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="@font/manrope_regular" android:textColor="@color/colorPrimary" android:textSize="10sp" android:gravity="center" android:maxLines="1" android:ellipsize="end" />
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>