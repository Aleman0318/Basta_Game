<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:background="@drawable/bg_fondocuaderno">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="72dp"
        android:paddingBottom="45dp">

        <TextView
            android:id="@+id/tvTituloModos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lilitaone_regular"
            android:gravity="center"
            android:text="¡A JUGAR!"
            android:textColor="@color/colorPrimary"
            android:textSize="42sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtituloModos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/manrope_regular"
            android:gravity="center"
            android:text="Elige cómo quieres entrar a la partida"
            android:textColor="@color/colorTextoP"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloModos" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIntroModos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/blanco"
            app:cardCornerRadius="26dp"
            app:cardElevation="7dp"
            app:strokeColor="#D6E0FF"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtituloModos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    app:cardBackgroundColor="#EEF4FF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/lilitaone_regular"
                        android:gravity="center"
                        android:text="ABC"
                        android:textColor="@color/colorPrimary"
                        android:textSize="15sp" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="Basta Online"
                        android:textColor="@color/colorTextoP"
                        android:textSize="23sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Crea una sala o entra con el código de tus amigos."
                        android:textColor="@color/colorContenidoInputs"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCrearSala"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/blanco"
            app:cardCornerRadius="28dp"
            app:cardElevation="9dp"
            app:strokeWidth="2.5dp"
            app:strokeColor="@color/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/cardIntroModos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorCelestePalido"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="1.5dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_crear_sala_azul" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        app:cardBackgroundColor="#EEF4FF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/colorPrimary"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/manrope_regular"
                            android:gravity="center"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:text="HOST"
                            android:textColor="@color/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="Crear sala"
                        android:textColor="@color/colorPrimary"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Sé el anfitrión y personaliza las reglas."
                        android:textColor="@color/colorTextoP"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorPrimary"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/lilitaone_regular"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="@color/colorPrimary"
                        android:textSize="32sp"
                        android:includeFontPadding="false" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUnirseSala"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/blanco"
            app:cardCornerRadius="28dp"
            app:cardElevation="9dp"
            app:strokeWidth="2.5dp"
            app:strokeColor="@color/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/cardCrearSala"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorSecondaryTenue"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="14dp"
                android:paddingBottom="18dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorSecondary"
                    app:strokeWidth="1.5dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_unirse_sala_naranja" />

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        app:cardBackgroundColor="@color/blanco"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/colorSecondary"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/manrope_regular"
                            android:gravity="center"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:text="CÓDIGO"
                            android:textColor="@color/colorSecondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/lilitaone_regular"
                        android:text="Unirse"
                        android:textColor="@color/colorSecondary"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/manrope_regular"
                        android:text="Ingresa con un código de invitación."
                        android:textColor="@color/colorTextoP"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    app:cardBackgroundColor="@color/blanco"
                    app:cardCornerRadius="19dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorSecondary"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/lilitaone_regular"
                        android:gravity="center"
                        android:text="›"
                        android:textColor="@color/colorSecondary"
                        android:textSize="32sp"
                        android:includeFontPadding="false" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvNotaModos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/manrope_regular"
            android:gravity="center"
            android:text="Tip: crea una sala para jugar con tus amigos o únete si ya tienes un código."
            android:textColor="@color/colorContenidoInputs"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cardUnirseSala"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>