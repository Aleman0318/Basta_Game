<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#FFFDF6" app:cardCornerRadius="20dp" app:strokeColor="#14244D" app:strokeWidth="2dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
<TextView android:id="@+id/txtTiempoVotacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/lilitaone_regular" android:textSize="28sp" android:textColor="@color/colorPrimary"/>
<TextView android:id="@+id/txtPalabraAEvaluar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/lilitaone_regular" android:textSize="21sp" android:textColor="#14244D"/>
<TextView android:id="@+id/txtJugadorEvaluado" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/manrope_regular" android:textSize="12sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/btnVotoNo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="0dp" android:minWidth="0dp" android:text="Inválida" android:textSize="14sp" app:backgroundTint="#C62828"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnVotoSi" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginHorizontal="6dp" android:padding="0dp" android:minWidth="0dp" android:text="Válida" android:textSize="14sp" app:backgroundTint="#2E7D32"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnVotoAbstenerse" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="0dp" android:minWidth="0dp" android:text="Paso" android:contentDescription="Abstenerse" android:textSize="14sp" app:backgroundTint="#826300"/>
</LinearLayout>
<TextView android:id="@+id/txtEstadoVotoUsuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:fontFamily="@font/manrope_regular" android:textStyle="bold" android:textColor="#14244D" android:textSize="14sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/txtVotosNo" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:textColor="#C62828" />
<TextView android:id="@+id/txtVotosSi" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:textColor="#237A31" />
<TextView android:id="@+id/txtVotosAbstenerse" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:textStyle="bold" android:textColor="#705700" />
</LinearLayout></LinearLayout></com.google.android.material.card.MaterialCardView>